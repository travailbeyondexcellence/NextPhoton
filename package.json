
{
  "name": "next-photon-Zen-EduCare-Management-System",
  "private": true,
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "frontend/web",
    "shared/*"
  ],
  "scripts": {
    "web": "cd frontend/web && bun run dev",
    "install:all": "cd frontend/web && bun install && cd ../.. && cd shared && bun install && cd ..",
    "install:frontend": "cd frontend/web && bun install",
    "install:shared": "cd shared && bun install",
    "start:all": "turbo run dev --filter=frontend-web... --parallel --output-logs=full",
    "build": "turbo run build",
    "prisma:generate": "bunx prisma generate --schema=shared/prisma/schema",
    "prisma:push": "bunx prisma db push --schema=shared/prisma/schema && bunx prisma generate --schema=shared/prisma/schema",
    "prisma:migrate": "bunx prisma migrate dev --name your_change_name --schema=shared/prisma/schema",
    "prisma:deployprod": "bunx prisma migrate deploy --schema=shared/prisma/schema",
    "prisma:studio": "bunx prisma studio --schema=shared/prisma/schema",
    "test:db": "bunx tsx shared/db/test-connection.ts",
    "test:prisma": "bun run test:db",
    "go:auth": "cd backend/services/auth && go run ./cmd/server",
    "go:user": "cd backend/services/user-service && go run ./cmd/server",
    "go:session": "cd backend/services/session-service && go run ./cmd/server",
    "go:notification": "cd backend/services/notification-service && go run ./cmd/server",
    "go:payment": "cd backend/services/payment-service && go run ./cmd/server",
    "go:media": "cd backend/services/media-service && go run ./cmd/server",
    "go:analytics": "cd backend/services/analytics-service && go run ./cmd/server",
    "go:gateway": "cd backend/api-gateway && go run ./cmd/server",
    "docker:up": "cd backend && docker-compose up -d",
    "docker:down": "cd backend && docker-compose down",
    "docker:logs": "cd backend && docker-compose logs -f"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.2.8",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "turbo": "*"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "dotenv": "^16.5.0",
    "react-hook-form": "^7.56.3",
    "simplebar-react": "^3.3.1",
    "zod": "^3.24.4"
  }
}
