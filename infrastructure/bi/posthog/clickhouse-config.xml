<?xml version="1.0"?>
<!--
  NextPhoton PostHog ClickHouse Custom Configuration

  This configuration optimizes ClickHouse for PostHog event analytics:
  - Memory limits appropriate for containerized environments
  - Query settings optimized for analytics workloads
  - Compression settings for efficient storage
-->
<clickhouse>
    <!-- Memory Settings -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <max_memory_usage>10000000000</max_memory_usage>

    <!-- Query Settings -->
    <profiles>
        <default>
            <!-- Max execution time for queries (seconds) -->
            <max_execution_time>300</max_execution_time>

            <!-- Memory limit per query -->
            <max_memory_usage>5000000000</max_memory_usage>

            <!-- Enable query profiling for performance analysis -->
            <log_queries>1</log_queries>

            <!-- Distributed query settings -->
            <distributed_aggregation_memory_efficient>1</distributed_aggregation_memory_efficient>

            <!-- Join algorithm preferences -->
            <join_algorithm>auto</join_algorithm>

            <!-- Result size limits -->
            <max_result_rows>100000000</max_result_rows>
            <max_result_bytes>10000000000</max_result_bytes>
        </default>

        <!-- Profile for heavy analytics queries -->
        <analytics>
            <max_execution_time>600</max_execution_time>
            <max_memory_usage>8000000000</max_memory_usage>
            <max_threads>8</max_threads>
        </analytics>
    </profiles>

    <!-- Compression Settings -->
    <compression>
        <case>
            <min_part_size>10000000000</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>

    <!-- Merge Tree Settings -->
    <merge_tree>
        <max_suspicious_broken_parts>10</max_suspicious_broken_parts>
        <parts_to_delay_insert>300</parts_to_delay_insert>
        <parts_to_throw_insert>600</parts_to_throw_insert>
        <max_delay_to_insert>1</max_delay_to_insert>
    </merge_tree>

    <!-- Logging Configuration -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- HTTP Interface Settings -->
    <http_server_default_response><![CDATA[<html><body><h1>ClickHouse Server - NextPhoton PostHog</h1></body></html>]]></http_server_default_response>

    <!-- Query Cache (for repeated analytical queries) -->
    <query_cache>
        <max_size_in_bytes>1073741824</max_size_in_bytes>
        <max_entries>1024</max_entries>
        <max_entry_size_in_bytes>104857600</max_entry_size_in_bytes>
        <max_entry_size_in_rows>30000000</max_entry_size_in_rows>
    </query_cache>
</clickhouse>
