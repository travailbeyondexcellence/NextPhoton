NODE_ENV=development

# Database (shared by all services)
DATABASE_URL=postgresql://user:password@host:5432/nextphoton_dev?sslmode=require

# JWT (shared by all services)
JWT_SECRET=generate-a-secure-random-string-min-32-chars
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:369

# Frontend
FRONTEND_PORT=369
NEXT_PUBLIC_API_URL=http://localhost:3960

# Go Microservices Ports
GATEWAY_PORT=3960
BACKEND_PORT=3963
USER_SERVICE_PORT=3964
SESSION_SERVICE_PORT=3965
NOTIFICATION_SERVICE_PORT=3966
PAYMENT_SERVICE_PORT=3967
MEDIA_SERVICE_PORT=3968
ANALYTICS_SERVICE_PORT=3969

# Service URLs (for API Gateway)
AUTH_SERVICE_URL=http://localhost:3963
USER_SERVICE_URL=http://localhost:3964
SESSION_SERVICE_URL=http://localhost:3965
NOTIFICATION_SERVICE_URL=http://localhost:3966
PAYMENT_SERVICE_URL=http://localhost:3967
MEDIA_SERVICE_URL=http://localhost:3968
ANALYTICS_SERVICE_URL=http://localhost:3969

# NATS Message Queue
NATS_URL=nats://localhost:4222

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe (Payment Service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
