# NextPhoton Frontend Environment Variables
# Copy this file to .env.local and update with your values

# Backend API URL - Go API Gateway
# Default: http://localhost:3960
NEXT_PUBLIC_API_URL=http://localhost:3960

# Frontend Application URL
# Default: http://localhost:369
NEXT_PUBLIC_APP_URL=http://localhost:369

# Other optional configurations
# Add any additional environment variables below